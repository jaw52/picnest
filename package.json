{
  "name": "picnest",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/desktop/frontend"
  ],
  "scripts": {
    "dev": "cd apps/desktop && CGO_ENABLED=0 go tool mygo dev",
    "build": "cd apps/desktop && CGO_ENABLED=0 go tool mygo build",
    "generate": "cd apps/desktop && CGO_ENABLED=0 go tool mygo generate",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test && cd apps/desktop && go test ./...",
    "lint": "oxlint && eslint . && bun run lint:go && bun run lint:dup",
    "lint:fix": "oxlint --fix && eslint . --fix && gofmt -w apps/desktop/*.go",
    "lint:go": "cd apps/desktop && test -z \"$(gofmt -l .)\" && go vet ./...",
    "lint:dup": "jscpd",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@eslint-react/eslint-plugin": "^5.22.1",
    "@stylexjs/eslint-plugin": "0.19.1",
    "eslint": "^10.11.0",
    "eslint-plugin-oxlint": "^1.86.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jiti": "^2.7.0",
    "jscpd": "^5.4.1",
    "lint-staged": "^17.5.0",
    "oxlint": "^1.85.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged && bunx jscpd --silent"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "eslint --fix"
    ]
  },
  "trustedDependencies": [
    "esbuild",
    "simple-git-hooks"
  ]
}
