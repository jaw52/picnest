{
  "name": "picnest",
  "type": "module",
  "version": "0.7.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:dev": "vue-tsc --noEmit && vite build --minify false --mode development",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:frontend",
    "@vueuse/core": "catalog:frontend",
    "motion-v": "catalog:frontend",
    "mygo-runtime": "catalog:frontend",
    "reka-ui": "catalog:frontend",
    "vue": "catalog:frontend",
    "vue-i18n": "catalog:frontend"
  },
  "devDependencies": {
    "@iconify-json/mingcute": "catalog:icons",
    "@types/node": "catalog:dev",
    "@vitejs/plugin-vue": "catalog:build",
    "@vue/test-utils": "catalog:testing",
    "happy-dom": "catalog:testing",
    "typescript": "catalog:dev",
    "unocss": "catalog:build",
    "vite": "catalog:build",
    "vitest": "catalog:testing",
    "vue-tsc": "catalog:dev"
  }
}
